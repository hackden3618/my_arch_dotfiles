{
    "label" : "lock",        "action" : "loginctl lock-session",                          "text" : "Lock",     "keybind" : "l"
}
{
    "label" : "reboot",      "action" : "/usr/bin/systemctl reboot",                        "text" : "Reboot",   "keybind" : "r"
}
{
    "label" : "shutdown",    "action" : "/usr/bin/systemctl poweroff",                      "text" : "Shutdown", "keybind" : "s"
}
{
    "label" : "logout",      "action" : "hyprctl dispatch 'hl.dsp.exit()'",                     "text" : "Logout",   "keybind" : "e"
}
{
    "label" : "suspend",     "action" : "/usr/bin/systemctl suspend",                       "text" : "Suspend",  "keybind" : "u"
}
{
    "label" : "hibernate",   "action" : "/usr/bin/systemctl hibernate",                     "text" : "Hibernate","keybind" : "h"
}
