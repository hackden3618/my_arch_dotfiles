 /* wallust template - colors-rofi */

* {
active-background: #606E76;
active-foreground: #CDD3D6;
normal-background: #101111;
normal-foreground: #CDD3D6;
urgent-background: #718189;
urgent-foreground: #CDD3D6;

alternate-active-background: #505C62;
alternate-active-foreground: #CDD3D6;
alternate-normal-background: #101111;
alternate-normal-foreground: #CDD3D6;
alternate-urgent-background: #101111;
alternate-urgent-foreground: #CDD3D6;

selected-active-background: #606E76;
selected-active-foreground: #101111;
selected-normal-background: #606E76;
selected-normal-foreground: #101111;
selected-urgent-background: #505C62;
selected-urgent-foreground: #101111;

background-color: #101111;
background: rgba(0,0,0,0.7);
foreground: #CDD3D6;
border-color: #606E76;

color0: #38393A;
color1: #23292D;
color2: #2F373B;
color3: #3C454A;
color4: #485358;
color5: #556167;
color6: #556167;
color7: #B0B8BC;
color8: #7B8083;
color9: #2E363C;
color10: #3F494F;
color11: #505C62;
color12: #606E76;
color13: #718189;
color14: #718189;
color15: #B0B8BC;


}

