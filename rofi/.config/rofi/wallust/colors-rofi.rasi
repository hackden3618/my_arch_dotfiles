 /* wallust template - colors-rofi */

* {
active-background: #1C6F3A;
active-foreground: #C6EEBC;
normal-background: #151818;
normal-foreground: #C6EEBC;
urgent-background: #22883F;
urgent-foreground: #C6EEBC;

alternate-active-background: #1D3D4F;
alternate-active-foreground: #C6EEBC;
alternate-normal-background: #151818;
alternate-normal-foreground: #C6EEBC;
alternate-urgent-background: #151818;
alternate-urgent-foreground: #C6EEBC;

selected-active-background: #1C6F3A;
selected-active-foreground: #151818;
selected-normal-background: #1C6F3A;
selected-normal-foreground: #151818;
selected-urgent-background: #1D3D4F;
