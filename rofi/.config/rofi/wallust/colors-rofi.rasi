 /* wallust template - colors-rofi */

* {
active-background: #A17649;
active-foreground: #FDF0CC;
normal-background: #1E1E1E;
normal-foreground: #FDF0CC;
urgent-background: #BADDC2;
urgent-foreground: #FDF0CC;

alternate-active-background: #A17649;
alternate-active-foreground: #FDF0CC;
alternate-normal-background: #1E1E1E;
alternate-normal-foreground: #FDF0CC;
alternate-urgent-background: #1E1E1E;
alternate-urgent-foreground: #FDF0CC;

selected-active-background: #A17649;
selected-active-foreground: #1E1E1E;
selected-normal-background: #A17649;
selected-normal-foreground: #1E1E1E;
selected-urgent-background: #A17649;
selected-urgent-foreground: #1E1E1E;

background-color: #1E1E1E;
background: rgba(0,0,0,0.7);
foreground: #FDF0CC;
border-color: #A17649;

color0: #444544;
color1: #151715;
color2: #402F21;
color3: #795837;
color4: #795837;
color5: #8CA692;
color6: #BA9F52;
color7: #F3E1AE;
color8: #AA9E79;
color9: #1C1F1C;
color10: #553F2C;
color11: #A17649;
color12: #A17649;
color13: #BADDC2;
color14: #F8D46D;
color15: #F3E1AE;


}

