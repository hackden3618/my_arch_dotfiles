 /* wallust template - colors-rofi */

* {
active-background: #8C6F5E;
active-foreground: #F7EAD8;
normal-background: #000003;
normal-foreground: #F7EAD8;
urgent-background: #889BBF;
urgent-foreground: #F7EAD8;

alternate-active-background: #626C85;
alternate-active-foreground: #F7EAD8;
alternate-normal-background: #000003;
alternate-normal-foreground: #F7EAD8;
alternate-urgent-background: #000003;
alternate-urgent-foreground: #F7EAD8;

selected-active-background: #8C6F5E;
selected-active-foreground: #000003;
selected-normal-background: #8C6F5E;
selected-normal-foreground: #000003;
selected-urgent-background: #626C85;
selected-urgent-foreground: #000003;

background-color: #000003;
background: rgba(0,0,0,0.7);
foreground: #F7EAD8;
border-color: #8C6F5E;

color0: #000003;
color1: #25232C;
color2: #292832;
color3: #495164;
color4: #695346;
color5: #66748F;
color6: #AD926C;
color7: #EBD9BF;
color8: #A49886;
color9: #312F3A;
color10: #363642;
color11: #626C85;
color12: #8C6F5E;
color13: #889BBF;
color14: #E7C390;
color15: #EBD9BF;


}

