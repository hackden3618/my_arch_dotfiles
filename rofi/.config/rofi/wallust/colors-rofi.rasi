background-color: #151818;
background: rgba(0,0,0,0.7);
foreground: #C6EEBC;
border-color: #1C6F3A;

color0: #3B3F3F;
color1: #0E2027;
color2: #09271D;
color3: #162E3B;
color4: #15532B;
color5: #19662F;
color6: #459B31;
color7: #A5DF98;
color8: #749C6A;
