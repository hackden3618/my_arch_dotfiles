/* ---- 💫 https://github.com/JaKooLit 💫 ---- */
/* KooL Hyprland Rofi Style 6 */

/* ---- Configuration ---- */

configuration {
	modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "  apps";
    display-run:                "  term";
    display-filebrowser:        "  files";
    display-window:             "  window";
	drun-display-format:        "{name}";
	hover-select:               true;
	me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
	window-format:              "{w} · {c} · {t}";
}

/* ---- Load wallust colors ---- */
@theme "~/.config/rofi/wallust/colors-rofi.rasi"

/* ---- Global Properties ---- */
* {

    background-alt:              @color1;
    selected:                    @color12;
    active:                      @color11;
    urgent:                      @color13;

    /* Readability: wallust's foreground can come out dark on some wallpapers,
       so text is a fixed near-white. Wallust only drives the accent colours. */
    text-strong:                 #F2F6FF;
    text-muted:                  #B4BED3;
    scrim:                       #000000C4;
    scrim-solid:                 #000000E0;
    highlight:                   #FFFFFF26;

    text-selected:               @text-strong;
    text-color:                  @text-strong;
    border-color:                @selected;
}

/* ---- Window ---- */
window {
    // Default
    enabled:                    true;
    fullscreen:                 false;
    transparency:               "real";
    cursor:                     "default";
    spacing:                    0px;
    border:                     2px;
    border-radius:              30px;
    location:                   center;
    anchor:                     center;

    // Style Values
    width:                      50%;
    background-color:           @scrim;
}

/* ----- Main Box ----- */
mainbox {
    enabled:                     true;
    orientation:                 vertical;
    children:                    [ "inputbar", "listbox" ];
    background-color:            transparent;
}


/* ---- Inputbar ---- */
inputbar {
    enabled:                     true;
    padding:                     10px 10px 150px 10px;
    margin:                      10px;
    background-color:            transparent;
    border-radius:               25px;
    orientation:                 horizontal;
    children:                    ["entry", "dummy", "mode-switcher" ];
    background-image:            url("~/.config/rofi/.current_wallpaper", width);
}

/* ---- Entry input ---- */
entry {
    enabled:                     true;
    expand:                      false;
    width:                       300px;
    padding:                     10px;
    border-radius:               12px;
    background-color:            @scrim-solid;
    text-color:                  @text-strong;
    cursor:                      text;
    placeholder:                 "  Search "; // << Search symbol
    placeholder-color:           @text-muted;
}

/* ---- Listbox ---- */
listbox {
    spacing:                     10px;
    padding:                     10px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "message", "listview" ];
}

/* ---- Listview ---- */
listview {
    enabled:                     true;
    columns:                     2;
    lines:                       6;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;    
    spacing:                     10px;
    padding:					 10px;
    background-color:            transparent;

//  Adapt rofi theme
    border:                      0px;
}

/* ---- Scrollbar ---- */
scrollbar {
  	border:						0px;
  	border-radius:				10px;
  	background-color:				transparent;
  	handle-color: 				@active;
  	handle-width: 				2px ;
  	padding:      				0;
}
/* ---- Dummy ---- */
dummy {
    expand:                      true;
    background-color:            transparent;
}

/* ---- Mode Switcher ---- */
mode-switcher{
    enabled:                     true;
    spacing:                     10px;
    background-color:            transparent;
}
button {
    expand:                      false;
    padding:                     12px 16px;
    border-radius:               12px;
    background-color:            @scrim-solid;
    text-color:                  @text-strong;
    cursor:                      pointer;
}
button selected {
    background-color:            @selected;
    text-color:                  @text-strong;
    border:                      2px;
    border-color:                @text-strong;
}


/* ---- Elements ---- */
element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     15px;
    border-radius:               10px;
    background-color:            transparent;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @text-strong;
}
element normal.urgent {
    background-color:            @urgent;
    text-color:                  @text-strong;
}

/* Separate rules so selected text does not paint a second background */
element-text selected {
    background-color:            transparent;
    text-color:                  @text-strong;
}

element normal.active {
    background-color:            @active;
    text-color:                  @text-strong;
}

/* Selection: translucent white plate + accent outline. Readable on any
   wallust palette, light or dark, because the text never changes colour. */
element selected.normal {
    background-color:            @highlight;
    text-color:                  @text-strong;
    border:                      2px;
    border-color:                @selected;
}
element selected.urgent {
    background-color:            @highlight;
    text-color:                  @text-strong;
    border:                      2px;
    border-color:                @urgent;
}
element selected.active {
    background-color:            @highlight;
    text-color:                  @text-strong;
    border:                      2px;
    border-color:                @active;
}
// Adapt rofi theme
element alternate.normal {
    background-color:            transparent;
    text-color:                  @text-strong;
}
element alternate.urgent {
    background-color:            transparent;
    text-color:                  @text-strong;
}
element alternate.active {
    background-color:            transparent;
    text-color:                  @text-strong;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        36px;
    cursor:                      inherit;
}
element-text {
    font:                        "JetBrainsMono Nerd Font SemiBold 12";
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;

}

/* ---- Message ---- */
message {
    background-color:            @scrim-solid;
    border:                      0px;
}
textbox {
	margin:						 10px;
    padding:                     12px;
    border-radius:               10px;
    background-color:            @scrim-solid;
    text-color:                  @text-strong;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
error-message {
    padding:                     12px;
    border-radius:               20px;
    background-color:            @scrim-solid;
    text-color:                  @text-strong;
}
