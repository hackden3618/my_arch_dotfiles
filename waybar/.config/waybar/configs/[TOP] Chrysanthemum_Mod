	"custom/privacy-dots",
	"hyprland/window",
	],
  
"modules-center": [
	"custom/menu",
	"hyprland/workspaces#rw",
	"custom/swaync",
	], 
	
"modules-right": [
	"custom/updater",
	"power-profiles-daemon",
	"custom/keyboard",
	"custom/settings",
	"pulseaudio#1",
	"backlight#2", 
	"battery",
	"custom/nightlight",
	"custom/power"
	], 
}
