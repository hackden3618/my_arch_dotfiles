diff --git a/quickshell/.config/quickshell/scripts/sysstats.sh b/quickshell/.config/quickshell/scripts/sysstats.sh
new file mode 100755
index 0000000..8f8fd1d
--- /dev/null
+++ b/quickshell/.config/quickshell/scripts/sysstats.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Prints key=value lines for Sys.qml to parse. Sampled every 2 seconds.
+# Everything here is read-only and cheap; missing tools just omit their keys.
+
+read -r _ u n s idle iow irq sirq st _ < /proc/stat
+echo "cpu_total=$((u + n + s + idle + iow + irq + sirq + st))"
+echo "cpu_idle=$((idle + iow))"
+
+awk '/^MemTotal/{t=$2} /^MemAvailable/{a=$2} END{print "mem_total=" t; print "mem_avail=" a}' /proc/meminfo
+
+df -k --output=size,used / 2>/dev/null | awk 'NR==2{print "disk_total=" $1; print "disk_used=" $2}'
+
+awk -F'[: ]+' 'NR>2 && $2!="lo"{rx+=$3; tx+=$11} END{print "rx=" rx+0; print "tx=" tx+0}' /proc/net/dev
+
+t=0
+for f in /sys/class/thermal/thermal_zone*/temp; do
+  [ -r "$f" ] || continue
+  v=$(<"$f")
+  [ "$v" -gt "$t" ] 2>/dev/null && t=$v
+done
+echo "temp=$((t / 1000))"
+
+awk '{print "uptime=" int($1)}' /proc/uptime
+
+if command -v nmcli >/dev/null 2>&1; then
+  echo "wifi=$(nmcli radio wifi 2>/dev/null)"
+  echo "ssid=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')"
+fi
+
+if pgrep -x hyprsunset >/dev/null 2>&1; then echo "night=1"; else echo "night=0"; fi
+
+if command -v brightnessctl >/dev/null 2>&1; then
+  brightnessctl -m 2>/dev/null | awk -F, 'NR==1{gsub("%","",$4); print "bright=" $4}'
+fi
diff --git a/quickshell/.config/quickshell/services/Audio.qml b/quickshell/.config/quickshell/services/Audio.qml
new file mode 100644
index 0000000..0df7e8e
--- /dev/null
+++ b/quickshell/.config/quickshell/services/Audio.qml
@@ -0,0 +1,52 @@
+pragma Singleton
+
+import Quickshell
+import Quickshell.Services.Pipewire
+import QtQuick
+
+// Volume and mic over PipeWire. Hyprland keybinds call these through
+// `qs ipc call audio ...`, which also pops the OSD.
+Singleton {
+    id: root
+
+    readonly property var sink: Pipewire.defaultAudioSink
+    readonly property var source: Pipewire.defaultAudioSource
+
+    readonly property real volume: root.sink && root.sink.audio ? root.sink.audio.volume : 0
+    readonly property bool muted: root.sink && root.sink.audio ? root.sink.audio.muted : false
+    readonly property string sinkName: root.sink ? (root.sink.nickname || root.sink.description || root.sink.name) : "No output"
+
+    PwObjectTracker {
+        objects: [root.sink, root.source]
+    }
+
+    function setVolume(v) {
+        if (!root.sink || !root.sink.audio)
+            return;
+        const clamped = Math.max(0, Math.min(1, v));
+        root.sink.audio.muted = false;
+        root.sink.audio.volume = clamped;
+    }
+
+    function step(dir) {
+        const v = Math.max(0, Math.min(1, root.volume + dir * 0.05));
+        root.setVolume(v);
+        UiState.showOsd("volume", v);
+    }
+    function inc() { root.step(1); }
+    function dec() { root.step(-1); }
+
+    function toggleMute() {
+        if (!root.sink || !root.sink.audio)
+            return;
+        const next = !root.muted;
+        root.sink.audio.muted = next;
+        UiState.showOsd(next ? "mute" : "volume", next ? 0 : root.volume);
+    }
+
+    function toggleMic() {
+        if (!root.source || !root.source.audio)
+            return;
+        root.source.audio.muted = !root.source.audio.muted;
+    }
+}
diff --git a/quickshell/.config/quickshell/services/Net.qml b/quickshell/.config/quickshell/services/Net.qml
new file mode 100644
index 0000000..0147476
--- /dev/null
+++ b/quickshell/.config/quickshell/services/Net.qml
@@ -0,0 +1,143 @@
+pragma Singleton
+
+import Quickshell
+import Quickshell.Io
+import QtQuick
+
+// Wi-Fi scanning and connecting through nmcli. The Wi-Fi page sets `active`
+// while it is visible, which is the only time scanning runs.
+Singleton {
+    id: root
+
+    property bool active: false
+    property bool scanning: false
+    property var networks: []        // [{ ssid, signal, secure, inUse, known }]
+    property string busySsid: ""     // network a connect/disconnect is running for
+    property string status: ""       // last error, empty when fine
+    property bool needsPassword: false
+
+    // nmcli -t escapes ':' and '\' with a backslash
+    function splitTerse(line) {
+        const out = [];
+        let cur = "";
+        for (let i = 0; i < line.length; i++) {
+            const c = line[i];
+            if (c === "\\" && i + 1 < line.length) {
+                cur += line[i + 1];
+                i++;
+            } else if (c === ":") {
+                out.push(cur);
+                cur = "";
+            } else {
+                cur += c;
+            }
+        }
+        out.push(cur);
+        return out;
+    }
+
+    function _parse(text) {
+        const known = {};
+        const best = {};
+        for (const line of text.split("\n")) {
+            if (line.startsWith("K:")) {
+                const f = root.splitTerse(line.slice(2));
+                if (f.length >= 2 && f[1].indexOf("wireless") >= 0)
+                    known[f[0]] = true;
+            } else if (line.startsWith("W:")) {
+                const f = root.splitTerse(line.slice(2));
+                if (f.length < 4 || f[3].length === 0)
+                    continue;
+                const n = {
+                    inUse: f[0] === "*",
+                    signal: Number(f[1]) || 0,
+                    secure: f[2].length > 0 && f[2] !== "--",
+                    ssid: f[3],
+                    known: false
+                };
+                const prev = best[n.ssid];
+                if (!prev || n.inUse || (!prev.inUse && n.signal > prev.signal))
+                    best[n.ssid] = n;
+            }
+        }
+        const list = Object.values(best);
+        for (const n of list)
+            n.known = known[n.ssid] === true;
+        list.sort((a, b) => (b.inUse - a.inUse) || (b.known - a.known) || (b.signal - a.signal));
+        root.networks = list;
+    }
+
+    function scan() {
+        if (scanProc.running)
+            return;
+        root.scanning = true;
+        scanProc.running = true;
+    }
+
+    function connect(ssid, password) {
+        if (actionProc.running)
+            return;
+        root.busySsid = ssid;
+        root.status = "";
+        root.needsPassword = false;
+        const cmd = ["nmcli", "--wait", "20", "dev", "wifi", "connect", ssid];
+        if (password && password.length > 0)
+            cmd.push("password", password);
+        actionProc.command = cmd;
+        actionProc.running = true;
+    }
+
+    function disconnect(ssid) {
+        if (actionProc.running)
+            return;
+        root.busySsid = ssid;
+        actionProc.command = ["nmcli", "connection", "down", "id", ssid];
+        actionProc.running = true;
+    }
+
+    function forget(ssid) {
+        if (actionProc.running)
+            return;
+        root.busySsid = ssid;
+        actionProc.command = ["nmcli", "connection", "delete", "id", ssid];
+        actionProc.running = true;
+    }
+
+    Process {
+        id: scanProc
+        command: ["bash", "-c", "nmcli -t -f NAME,TYPE connection show | sed 's/^/K:/'; nmcli -t -f IN-USE,SIGNAL,SECURITY,SSID dev wifi list --rescan auto | sed 's/^/W:/'"]
+        stdout: StdioCollector {
+            onStreamFinished: root._parse(text)
+        }
+        onExited: root.scanning = false
+    }
+
+    Process {
+        id: actionProc
+        stdout: StdioCollector {
+            id: actionOut
+        }
+        stderr: StdioCollector {
+            id: actionErr
+        }
+        onExited: (code, status) => {
+            root.busySsid = "";
+            if (code === 0) {
+                root.status = "";
+            } else {
+                const msg = (actionErr.text || actionOut.text).trim();
+                root.needsPassword = msg.indexOf("Secrets were required") >= 0 || msg.indexOf("password") >= 0;
+                root.status = root.needsPassword ? "Password needed" : (msg.length > 0 ? msg : "Could not complete that");
+            }
+            root.scan();
+        }
+    }
+
+    Timer {
+        interval: 8000
+        repeat: true
+        running: root.active && Sys.wifiOn
+        triggeredOnStart: true
+        onTriggered: root.scan()
+    }
+}
diff --git a/quickshell/.config/quickshell/services/Notifs.qml b/quickshell/.config/quickshell/services/Notifs.qml
new file mode 100644
index 0000000..a2c9f40
--- /dev/null
+++ b/quickshell/.config/quickshell/services/Notifs.qml
@@ -0,0 +1,117 @@
+pragma Singleton
+
+import Quickshell
+import Quickshell.Services.Notifications
+import QtQuick
+
+// Quickshell is the notification daemon (replaces swaync). One tracked list
+// feeds the bar badge, the toasts and the Control Center shade.
+Singleton {
+    id: root
+
+    property bool dnd: false
+
+    // notifications currently shown as toasts (newest first)
+    property var popups: []
+
+    // when each notification arrived (the protocol carries no timestamp)
+    property var arrived: ({})
+    property int tick: 0
+
+    readonly property var all: server.trackedNotifications.values
+    readonly property int count: root.all.length
+
+    // grouped by app, newest group first; items newest first
+    readonly property var groups: {
+        const order = [];
+        const map = {};
+        const items = root.all.slice().reverse();
+        for (const n of items) {
+            const key = n.appName && n.appName.length > 0 ? n.appName : "System";
+            if (!map[key]) {
+                map[key] = { app: key, items: [] };
+                order.push(map[key]);
+            }
+            map[key].items.push(n);
+        }
+        return order;
+    }
+
+    // which app groups are expanded in the shade; kept here so a new
+    // notification does not collapse a group you are reading
+    property var expandedApps: ({})
+
+    function toggleExpand(app) {
+        const next = Object.assign({}, root.expandedApps);
+        next[app] = !next[app];
+        root.expandedApps = next;
+    }
+
+    function dismissGroup(group) {
+        for (const n of group.items.slice())
+            n.dismiss();
+    }
+
+    function dropPopup(n) {
+        root.popups = root.popups.filter(p => p !== n);
+    }
+
+    function clearAll() {
+        for (const n of root.all.slice())
+            n.dismiss();
+        root.popups = [];
+    }
+
+    function ago(n) {
+        root.tick; // re-evaluate every 30s
+        const t = root.arrived[n.id];
+        if (!t)
+            return "";
+        const s = Math.floor((Date.now() - t) / 1000);
+        if (s < 45) return "now";
+        if (s < 3600) return Math.max(1, Math.round(s / 60)) + "m";
+        if (s < 86400) return Math.round(s / 3600) + "h";
+        return Math.round(s / 86400) + "d";
+    }
+
+    NotificationServer {
+        id: server
+        keepOnReload: true
+        bodySupported: true
+        bodyMarkupSupported: true
+        bodyHyperlinksSupported: false
+        actionsSupported: true
+        imageSupported: true
+        persistenceSupported: true
+        inlineReplySupported: true
+
+        onNotification: n => {
+            n.tracked = true;
+
+            const stamped = Object.assign({}, root.arrived);
+            stamped[n.id] = Date.now();
+            root.arrived = stamped;
+
+            const critical = n.urgency === NotificationUrgency.Critical;
+            if (n.urgency === NotificationUrgency.Low)
+                return;                       // low priority goes straight to the shade
+            if (root.dnd && !critical)
+                return;                       // DND keeps toasts quiet, shade still fills
+            root.popups = [n].concat(root.popups).slice(0, 4);
+        }
+    }
+
+    Connections {
+        target: server.trackedNotifications
+        function onObjectRemoved(n) {
+            root.dropPopup(n);
+        }
+    }
+
+    Timer {
+        interval: 30000
+        running: true
+        repeat: true
+        onTriggered: root.tick++
+    }
+}
diff --git a/quickshell/.config/quickshell/services/Sys.qml b/quickshell/.config/quickshell/services/Sys.qml
new file mode 100644
index 0000000..21e7661
--- /dev/null
+++ b/quickshell/.config/quickshell/services/Sys.qml
@@ -0,0 +1,121 @@
+pragma Singleton
+
+import Quickshell
+import Quickshell.Io
+import QtQuick
+
+// System state sampled by scripts/sysstats.sh: CPU, memory, disk, temperature,
+// network speed, Wi-Fi, night light and backlight.
+Singleton {
+    id: root
+
+    readonly property string home: Quickshell.env("HOME")
+    readonly property string scriptsDir: root.home + "/.config/hypr/scripts"
+
+    property real cpu: 0
+    property real memUsedGb: 0
+    property real memTotalGb: 0
+    property real diskUsedGb: 0
+    property real diskTotalGb: 0
+    property int temp: 0
+    property int uptimeSec: 0
+
+    property real rxRate: 0
+    property real txRate: 0
+
+    property bool wifiOn: true
+    property string ssid: ""
+    property bool nightOn: false
+    property real bright: 0.5       // 0..1
+
+    // ---- formatting helpers -------------------------------------------------
+    function fmtRate(b) {
+        if (b >= 1048576) return (b / 1048576).toFixed(1) + "MB/s";
+        if (b >= 1024) return (b / 1024).toFixed(1) + "kB/s";
+        return b.toFixed(1) + "B/s";
+    }
+    function fmtUptime(s) {
+        const h = Math.floor(s / 3600);
+        const m = Math.floor((s % 3600) / 60);
+        return h > 0 ? h + "h " + m + "m" : m + "m";
+    }
+
+    // ---- actions ---------------------------------------------------------------
+    function toggleWifi() {
+        Quickshell.execDetached(["nmcli", "radio", "wifi", root.wifiOn ? "off" : "on"]);
+        root.wifiOn = !root.wifiOn;
+    }
+    function toggleNight() {
+        Quickshell.execDetached([root.scriptsDir + "/Hyprsunset.sh", "toggle"]);
+        root.nightOn = !root.nightOn;
+    }
+    function setBrightness(frac) {
+        const f = Math.max(0.01, Math.min(1, frac));
+        root.bright = f;
+        Quickshell.execDetached(["brightnessctl", "set", Math.round(f * 100) + "%"]);
+    }
+    function stepBrightness(dir) {
+        const f = Math.max(0.01, Math.min(1, root.bright + dir * 0.05));
+        root.setBrightness(f);
+        UiState.showOsd("brightness", f);
+    }
+
+    // ---- sampling ----------------------------------------------------------------
+    property var _prev: null
+
+    function _parse(text) {
+        const kv = {};
+        for (const line of text.split("\n")) {
+            const i = line.indexOf("=");
+            if (i > 0)
+                kv[line.slice(0, i)] = line.slice(i + 1).trim();
+        }
+        const now = Date.now();
+        const cpuTotal = Number(kv.cpu_total), cpuIdle = Number(kv.cpu_idle);
+        const rx = Number(kv.rx), tx = Number(kv.tx);
+
+        if (root._prev) {
+            const dt = Math.max(0.5, (now - root._prev.t) / 1000);
+            const dTotal = cpuTotal - root._prev.cpuTotal;
+            const dIdle = cpuIdle - root._prev.cpuIdle;
+            if (dTotal > 0)
+                root.cpu = Math.max(0, Math.min(1, 1 - dIdle / dTotal));
+            root.rxRate = Math.max(0, (rx - root._prev.rx) / dt);
+            root.txRate = Math.max(0, (tx - root._prev.tx) / dt);
+        }
+        root._prev = { t: now, cpuTotal: cpuTotal, cpuIdle: cpuIdle, rx: rx, tx: tx };
+
+        const gb = 1048576; // KiB -> GiB
+        root.memTotalGb = Number(kv.mem_total) / gb;
+        root.memUsedGb = (Number(kv.mem_total) - Number(kv.mem_avail)) / gb;
+        root.diskTotalGb = Number(kv.disk_total) / gb;
+        root.diskUsedGb = Number(kv.disk_used) / gb;
+        root.temp = Number(kv.temp) || 0;
+        root.uptimeSec = Number(kv.uptime) || 0;
+
+        if (kv.wifi !== undefined) root.wifiOn = kv.wifi === "enabled";
+        root.ssid = kv.ssid || "";
+        root.nightOn = kv.night === "1";
+        if (kv.bright !== undefined && kv.bright !== "")
+            root.bright = Math.max(0, Math.min(1, Number(kv.bright) / 100));
+    }
+
+    Process {
+        id: sampler
+        command: ["bash", Quickshell.shellPath("scripts/sysstats.sh")]
+        stdout: StdioCollector {
+            onStreamFinished: root._parse(text)
+        }
+    }
+
+    Timer {
+        interval: 2000
+        running: true
+        repeat: true
+        triggeredOnStart: true
+        onTriggered: {
+            if (!sampler.running)
+                sampler.running = true;
+        }
+    }
+}
diff --git a/quickshell/.config/quickshell/services/Theme.qml b/quickshell/.config/quickshell/services/Theme.qml
new file mode 100644
index 0000000..a7c89ca
--- /dev/null
+++ b/quickshell/.config/quickshell/services/Theme.qml
@@ -0,0 +1,123 @@
+pragma Singleton
+
+import Quickshell
+import Quickshell.Io
+import QtQuick
+
+// Every colour in the shell comes from here, and every value here comes from
+// wallust (~/.config/quickshell/qml_color.json, rendered from the template in
+// hypr/.config/wallust/templates/qml_color.json). Change wallpaper -> wallust
+// rewrites the file -> this singleton reloads it -> the whole shell recolours
+// live, no restart.
+Singleton {
+    id: root
+
+    property var raw: ({})
+
+    function pick(key, fallback) {
+        const v = root.raw[key];
+        return (typeof v === "string" && /^#[0-9a-fA-F]{6,8}$/.test(v)) ? v : fallback;
+    }
+
+    // WCAG relative luminance of a colour
+    function lum(c) {
+        function ch(v) { return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }
+        return 0.2126 * ch(c.r) + 0.7152 * ch(c.g) + 0.0722 * ch(c.b);
+    }
+    function ratio(a, b) {
+        const x = lum(a), y = lum(b);
+        return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
+    }
+    function mix(a, b, t) {
+        return Qt.rgba(a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t, 1);
+    }
+    // readable text colour for a given background
+    function onColor(c) { return root.lum(c) > 0.35 ? root.ink : root.snow; }
+
+    // ---- fixed anchors -----------------------------------------------------
+    readonly property color white: "#ffffff"
+    readonly property color snow: "#f4f7ff"
+    readonly property color ink: "#10141c"
+
+    // semantic colours that should not follow the wallpaper (same as your CSS)
+    readonly property color warm: "#ffa726"      // active workspace, play button
+    readonly property color danger: "#ff5d5d"    // unread dot, critical, low battery
+    readonly property color ok: "#2fb36b"
+
+    // ---- raw wallust palette ----------------------------------------------
+    readonly property color bg: root.pick("background", "#0f1218")
+    readonly property color fgRaw: root.pick("foreground", "#cdd3d6")
+    readonly property color c1: root.pick("color1", "#1a2030")
+    readonly property color c7: root.pick("color7", "#b0b8bc")
+    readonly property color c11: root.pick("color11", "#505c62")
+    readonly property color c12: root.pick("color12", "#606e76")
+    readonly property color c13: root.pick("color13", "#718189")
+
+    // ---- derived, contrast-checked tokens ----------------------------------
+    // wallust's foreground can be dim on some wallpapers, so lift it until it
+    // reads on the dark panels. This is what keeps text legible everywhere.
+    readonly property color fg: root.lum(root.fgRaw) < 0.5 ? root.mix(root.fgRaw, root.white, 0.7) : root.fgRaw
+    readonly property color muted: root.mix(root.fg, root.bg, 0.38)
+
+    readonly property color accent: root.ratio(root.c12, root.bg) < 2.5 ? root.mix(root.c12, root.white, 0.4) : root.c12
+    readonly property color onAccent: root.onColor(root.accent)
+    readonly property color accentEdge: root.mix(root.accent, root.white, 0.3)
+
+    readonly property color pill: Qt.alpha(root.c1, 0.92)
+    readonly property color pillHover: root.mix(root.c1, root.accent, 0.22)
+    readonly property color edge: root.c13
+    readonly property color edgeHi: root.mix(root.c13, root.white, 0.3)
+
+    readonly property color panel: Qt.alpha(root.bg, 0.82)
+    readonly property color panelEdge: Qt.alpha(root.c13, 0.4)
+    readonly property color card: root.mix(root.bg, root.fg, 0.09)
+    readonly property color cardEdge: Qt.alpha(root.fg, 0.08)
+    readonly property color tileOff: Qt.alpha(root.fg, 0.07)
+    readonly property color scrim: Qt.alpha(root.bg, 0.55)
+
+    // ---- type and shape ----------------------------------------------------
+    readonly property string font: "JetBrainsMono Nerd Font"
+    readonly property int radiusPill: 19
+    readonly property int radiusCard: 20
+    readonly property int radiusPanel: 28
+
+    // Reload only when the file content really changed. Assigning a fresh
+    // object to `raw` re-evaluates every colour binding in the shell, so doing
+    // it blindly (as a timer used to) burns CPU for nothing.
+    property string lastText: ""
+
+    FileView {
+        id: file
+        path: Quickshell.shellPath("qml_color.json")
+        watchChanges: true
+        onFileChanged: debounce.restart()
+        onLoaded: {
+            const t = text();
+            if (t === root.lastText)
+                return;
+            try {
+                const parsed = JSON.parse(t);
+                root.lastText = t;
+                root.raw = parsed;
+            } catch (e) {
+                console.warn("Theme: bad qml_color.json, keeping previous palette:", e);
+            }
+        }
+    }
+
+    // wallust writes several templates in a burst; wait for it to settle
+    Timer {
+        id: debounce
+        interval: 250
+        onTriggered: file.reload()
+    }
+
+    // safety net in case an atomic replace drops the inotify watch (cheap now:
+    // an unchanged file is ignored above)
+    Timer {
+        interval: 15000
+        running: true
+        repeat: true
+        onTriggered: file.reload()
+    }
+}
diff --git a/quickshell/.config/quickshell/services/UiState.qml b/quickshell/.config/quickshell/services/UiState.qml
new file mode 100644
index 0000000..abc5a0d
--- /dev/null
+++ b/quickshell/.config/quickshell/services/UiState.qml
@@ -0,0 +1,59 @@
+pragma Singleton
+
+import Quickshell
+import QtQuick
+
+// Shared UI state: which panels are open, caffeine, and the OSD.
+Singleton {
+    id: root
+
+    property bool ccOpen: false
+    // which page of the Control Center is showing
+    property string ccPage: "main"      // main | wifi | bluetooth | audio | theme
+    property bool powerOpen: false
+    property bool caffeine: false
+
+    property bool osdVisible: false
+    property string osdKind: "volume"   // volume | brightness | mute
+    property real osdValue: 0
+
+    function showOsd(kind, value) {
+        root.osdKind = kind;
+        root.osdValue = value;
+        root.osdVisible = true;
+        osdTimer.restart();
+    }
+
+    function toggleCc() {
+        root.powerOpen = false;
+        if (!root.ccOpen)
+            root.ccPage = "main";
+        root.ccOpen = !root.ccOpen;
+    }
+
+    // open the Control Center straight onto a page (right-click on a bar pill)
+    function openPage(page) {
+        root.powerOpen = false;
+        root.ccPage = page;
+        root.ccOpen = true;
+    }
+
+    // Escape / back arrow: leave a sub page first, then close the panel
+    function back() {
+        if (root.ccPage !== "main")
+            root.ccPage = "main";
+        else
+            root.ccOpen = false;
+    }
+
+    function togglePower() {
+        root.ccOpen = false;
+        root.powerOpen = !root.powerOpen;
+    }
+
+    Timer {
+        id: osdTimer
+        interval: 1500
+        onTriggered: root.osdVisible = false
+    }
+}
