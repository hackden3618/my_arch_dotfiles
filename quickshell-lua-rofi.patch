diff --git a/quickshell/.config/quickshell/components/MediaCard.qml b/quickshell/.config/quickshell/components/MediaCard.qml
new file mode 100644
index 0000000..916f97f
--- /dev/null
+++ b/quickshell/.config/quickshell/components/MediaCard.qml
@@ -0,0 +1,107 @@
+import QtQuick
+import QtQuick.Layouts
+import Quickshell.Services.Mpris
+import "../services"
+
+// Now-playing card. Hidden when nothing is playing.
+Rectangle {
+    id: card
+
+    readonly property var player: {
+        const list = Mpris.players.values;
+        return list.find(p => p.isPlaying) ?? list[0] ?? null;
+    }
+
+    visible: card.player !== null
+    implicitHeight: card.visible ? 80 : 0
+    radius: Theme.radiusCard
+    color: Theme.tileOff
+    border.width: 1
+    border.color: Theme.cardEdge
+
+    // position is not pushed by most players, so nudge it once a second
+    Timer {
+        interval: 1000
+        repeat: true
+        running: card.visible && card.player !== null && card.player.isPlaying
+        onTriggered: card.player.positionChanged()
+    }
+
+    RowLayout {
+        anchors.fill: parent
+        anchors.margins: 12
+        spacing: 12
+
+        Rectangle {
+            Layout.preferredWidth: 56
+            Layout.preferredHeight: 56
+            radius: 14
+            clip: true
+            gradient: Gradient {
+                orientation: Gradient.Horizontal
+                GradientStop { position: 0; color: Theme.accent }
+                GradientStop { position: 1; color: Theme.warm }
+            }
+
+            Image {
+                anchors.fill: parent
+                source: card.player ? card.player.trackArtUrl : ""
+                visible: source !== ""
+                fillMode: Image.PreserveAspectCrop
+            }
+        }
+
+        ColumnLayout {
+            Layout.fillWidth: true
+            spacing: 2
+
+            Txt {
+                Layout.fillWidth: true
+                text: card.player ? (card.player.trackTitle || "Unknown") : ""
+                strong: true
+            }
+            Txt {
+                Layout.fillWidth: true
+                text: card.player ? (card.player.trackArtist || card.player.identity) : ""
+                size: 11
+                color: Theme.muted
+            }
+            Rectangle {
+                Layout.fillWidth: true
+                Layout.topMargin: 6
+                implicitHeight: 4
+                radius: 2
+                color: Qt.alpha(Theme.fg, 0.14)
+
+                Rectangle {
+                    height: 4
+                    radius: 2
+                    color: Theme.warm
+                    width: card.player && card.player.length > 0 ? parent.width * Math.max(0, Math.min(1, card.player.position / card.player.length)) : 0
+                }
+            }
+        }
+
+        RowLayout {
+            spacing: 2
+
+            IconButton {
+                glyph: ""
+                color: "transparent"
+                border.width: 0
+                onClicked: card.player.previous()
+            }
+            IconButton {
+                primary: true
+                glyph: card.player && card.player.isPlaying ? "" : ""
+                onClicked: card.player.togglePlaying()
+            }
+            IconButton {
+                glyph: ""
+                color: "transparent"
+                border.width: 0
+                onClicked: card.player.next()
+            }
+        }
+    }
+}
diff --git a/quickshell/.config/quickshell/components/NotifCard.qml b/quickshell/.config/quickshell/components/NotifCard.qml
new file mode 100644
index 0000000..9dd5280
--- /dev/null
+++ b/quickshell/.config/quickshell/components/NotifCard.qml
@@ -0,0 +1,180 @@
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import Quickshell.Services.Notifications
+import "../services"
+
+// One notification. Used both as a toast and as a card in the Control Center.
+Rectangle {
+    id: card
+
+    required property var notif
+    property bool toast: false
+
+    readonly property bool critical: card.notif.urgency === NotificationUrgency.Critical
+    readonly property string app: card.notif.appName && card.notif.appName.length > 0 ? card.notif.appName : "System"
+    readonly property bool hovered: hover.hovered || reply.activeFocus
+
+    function hue(s) {
+        let h = 0;
+        for (let i = 0; i < s.length; i++)
+            h = (h * 31 + s.charCodeAt(i)) % 360;
+        return h / 360;
+    }
+
+    implicitHeight: col.implicitHeight + 24
+    radius: Theme.radiusCard
+    color: card.toast ? Qt.alpha(Theme.bg, 0.94) : Theme.card
+    border.width: card.critical ? 2 : 1
+    border.color: card.critical ? Theme.danger : (card.toast ? Theme.panelEdge : Theme.cardEdge)
+
+    HoverHandler {
+        id: hover
+    }
+
+    // toasts leave on their own; critical ones stay until dismissed
+    Timer {
+        running: card.toast && !card.critical && !card.hovered
+        interval: card.notif.expireTimeout > 0 ? card.notif.expireTimeout * 1000 : 5000
+        onTriggered: Notifs.dropPopup(card.notif)
+    }
+
+    ColumnLayout {
+        id: col
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.top: parent.top
+        anchors.margins: 12
+        spacing: 10
+
+        RowLayout {
+            Layout.fillWidth: true
+            spacing: 12
+
+            Rectangle {
+                Layout.preferredWidth: 34
+                Layout.preferredHeight: 34
+                Layout.alignment: Qt.AlignTop
+                radius: 11
+                clip: true
+                color: card.critical ? Theme.danger : Qt.hsla(card.hue(card.app), 0.5, 0.36, 1)
+
+                Image {
+                    anchors.fill: parent
+                    visible: card.notif.image !== ""
+                    source: card.notif.image
+                    fillMode: Image.PreserveAspectCrop
+                }
+                Txt {
+                    anchors.centerIn: parent
+                    visible: card.notif.image === ""
+                    text: card.critical ? "!" : card.app.charAt(0).toUpperCase()
+                    strong: true
+                    color: card.critical ? Theme.ink : Theme.snow
+                }
+            }
+
+            ColumnLayout {
+                Layout.fillWidth: true
+                spacing: 2
+
+                Txt {
+                    Layout.fillWidth: true
+                    text: (card.critical ? "CRITICAL · " : "") + card.app + (Notifs.ago(card.notif) ? " · " + Notifs.ago(card.notif) : "")
+                    size: 11
+                    color: card.critical ? Theme.danger : Theme.muted
+                }
+                Txt {
+                    Layout.fillWidth: true
+                    visible: text.length > 0
+                    text: card.notif.summary
+                    strong: true
+                    wrapMode: Text.Wrap
+                    maximumLineCount: 2
+                }
+                Txt {
+                    Layout.fillWidth: true
+                    visible: text.length > 0
+                    text: card.notif.body
+                    size: 12
+                    color: Qt.alpha(Theme.fg, 0.88)
+                    textFormat: Text.StyledText
+                    wrapMode: Text.Wrap
+                    maximumLineCount: card.toast ? 3 : 4
+                }
+            }
+
+            IconButton {
+                Layout.alignment: Qt.AlignTop
+                size: 28
+                glyph: ""
+                onClicked: {
+                    if (card.toast)
+                        Notifs.dropPopup(card.notif);
+                    else
+                        card.notif.dismiss();
+                }
+            }
+        }
+
+        RowLayout {
+            Layout.fillWidth: true
+            visible: card.notif.actions.length > 0
+            spacing: 6
+
+            Repeater {
+                model: card.notif.actions
+                delegate: Chip {
+                    required property var modelData
+                    visible: modelData.text !== "" && modelData.identifier !== "default"
+                    text: modelData.text
+                    onClicked: {
+                        modelData.invoke();
+                        if (card.toast)
+                            Notifs.dropPopup(card.notif);
+                    }
+                }
+            }
+            Item {
+                Layout.fillWidth: true
+            }
+        }
+
+        RowLayout {
+            Layout.fillWidth: true
+            visible: card.notif.hasInlineReply
+            spacing: 8
+
+            TextField {
+                id: reply
+                Layout.fillWidth: true
+                implicitHeight: 36
+                placeholderText: card.notif.inlineReplyPlaceholder || "Reply"
+                color: Theme.fg
+                placeholderTextColor: Theme.muted
+                font.family: Theme.font
+                font.pixelSize: 12
+                leftPadding: 14
+                rightPadding: 14
+                background: Rectangle {
+                    radius: 18
+                    color: Qt.alpha(Theme.fg, 0.08)
+                    border.width: 1
+                    border.color: reply.activeFocus ? Theme.accentEdge : Qt.alpha(Theme.fg, 0.16)
+                }
+                onAccepted: {
+                    if (text.length === 0)
+                        return;
+                    card.notif.sendInlineReply(text);
+                    text = "";
+                }
+            }
+            IconButton {
+                size: 36
+                primary: true
+                glyph: ""
+                onClicked: reply.accepted()
+            }
+        }
+    }
+}
diff --git a/quickshell/.config/quickshell/components/NotifGroup.qml b/quickshell/.config/quickshell/components/NotifGroup.qml
new file mode 100644
index 0000000..ba3c3ed
--- /dev/null
+++ b/quickshell/.config/quickshell/components/NotifGroup.qml
@@ -0,0 +1,110 @@
+import QtQuick
+import QtQuick.Layouts
+import "../services"
+
+// One app's notifications. A single item is just a card. Several collapse
+// into a stack (newest on top, two "peeking" cards beneath) that expands in
+// place, like Android and macOS.
+ColumnLayout {
+    id: group
+
+    required property var modelData   // { app, items }
+
+    readonly property var items: group.modelData.items
+    readonly property bool multi: group.items.length > 1
+    readonly property bool expanded: Notifs.expandedApps[group.modelData.app] === true
+
+    spacing: 6
+
+    // ---- single, or the newest card of a collapsed stack ----
+    Item {
+        Layout.fillWidth: true
+        visible: !group.multi || !group.expanded
+        implicitHeight: newest.implicitHeight + (group.multi ? 14 : 0)
+
+        Rectangle {
+            visible: group.multi
+            anchors.left: parent.left
+            anchors.right: parent.right
+            anchors.leftMargin: 12
+            anchors.rightMargin: 12
+            anchors.bottom: parent.bottom
+            anchors.bottomMargin: 6
+            height: 28
+            radius: Theme.radiusCard
+            color: Qt.alpha(Theme.card, 0.7)
+            border.width: 1
+            border.color: Theme.cardEdge
+        }
+        Rectangle {
+            visible: group.multi
+            anchors.left: parent.left
+            anchors.right: parent.right
+            anchors.leftMargin: 24
+            anchors.rightMargin: 24
+            anchors.bottom: parent.bottom
+            height: 24
+            radius: Theme.radiusCard
+            color: Qt.alpha(Theme.card, 0.45)
+            border.width: 1
+            border.color: Theme.cardEdge
+        }
+
+        NotifCard {
+            id: newest
+            anchors.left: parent.left
+            anchors.right: parent.right
+            anchors.top: parent.top
+            notif: group.items[0]
+        }
+    }
+
+    // ---- collapsed stack controls ----
+    RowLayout {
+        Layout.fillWidth: true
+        visible: group.multi && !group.expanded
+        spacing: 6
+
+        Chip {
+            text: "Show all " + group.items.length
+            onClicked: Notifs.toggleExpand(group.modelData.app)
+        }
+        Chip {
+            text: "Clear"
+            onClicked: Notifs.dismissGroup(group.modelData)
+        }
+        Item {
+            Layout.fillWidth: true
+        }
+    }
+
+    // ---- expanded ----
+    RowLayout {
+        Layout.fillWidth: true
+        visible: group.multi && group.expanded
+        spacing: 8
+
+        Txt {
+            Layout.fillWidth: true
+            text: group.modelData.app + " · " + group.items.length
+            strong: true
+        }
+        Chip {
+            text: "Show less"
+            onClicked: Notifs.toggleExpand(group.modelData.app)
+        }
+        Chip {
+            text: "Clear"
+            onClicked: Notifs.dismissGroup(group.modelData)
+        }
+    }
+
+    Repeater {
+        model: group.multi && group.expanded ? group.items : []
+        delegate: NotifCard {
+            required property var modelData
+            Layout.fillWidth: true
+            notif: modelData
+        }
+    }
+}
diff --git a/quickshell/.config/quickshell/components/Osd.qml b/quickshell/.config/quickshell/components/Osd.qml
