+}
diff --git a/quickshell/.config/quickshell/components/PowerMenu.qml b/quickshell/.config/quickshell/components/PowerMenu.qml
new file mode 100644
index 0000000..0c961fc
--- /dev/null
+++ b/quickshell/.config/quickshell/components/PowerMenu.qml
@@ -0,0 +1,194 @@
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Wayland
+import Quickshell.Hyprland
+import "../services"
+
+// Power menu (replaces wlogout). Keys: L E S R P, arrows + Enter, Esc.
+// Restart and Shutdown count down 5 seconds so a stray click can be undone.
+PanelWindow {
+    id: win
+
+    readonly property var focusedScreen: Quickshell.screens.find(s => s.name === Hyprland.focusedMonitor?.name) ?? Quickshell.screens[0]
+    readonly property string scriptsDir: Quickshell.env("HOME") + "/.config/hypr/scripts"
+
+    readonly property var actions: [
+        { key: "l", glyph: "", label: "Lock",     confirm: false, cmd: [win.scriptsDir + "/LockScreen.sh"] },
+        { key: "e", glyph: "", label: "Logout",   confirm: false, cmd: ["hyprctl", "dispatch", "hl.dsp.exit()"] },
+        { key: "s", glyph: "", label: "Sleep",    confirm: false, cmd: ["systemctl", "suspend"] },
+        { key: "r", glyph: "", label: "Restart",  confirm: true,  cmd: ["systemctl", "reboot"] },
+        { key: "p", glyph: "", label: "Shutdown", confirm: true,  cmd: ["systemctl", "poweroff"] }
+    ]
+
+    property int selected: 4
+    property var pending: null
+    property int countdown: 0
+
+    function close() {
+        countdownTimer.stop();
+        win.pending = null;
+        UiState.powerOpen = false;
+    }
+    function fire(a) {
+        win.close();
+        Quickshell.execDetached(a.cmd);
+    }
+    function choose(a) {
+        if (!a.confirm) {
+            win.fire(a);
+            return;
+        }
+        win.pending = a;
+        win.countdown = 5;
+        countdownTimer.restart();
+    }
+    function cancel() {
+        if (win.pending !== null) {
+            countdownTimer.stop();
+            win.pending = null;
+        } else {
+            win.close();
+        }
+    }
+
+    screen: win.focusedScreen
+    visible: UiState.powerOpen
+    color: Theme.scrim
+    anchors {
+        top: true
+        bottom: true
+        left: true
+        right: true
+    }
+    exclusionMode: ExclusionMode.Ignore
+
+    WlrLayershell.namespace: "qs-power"
+    WlrLayershell.layer: WlrLayer.Overlay
+    WlrLayershell.keyboardFocus: UiState.powerOpen ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None
+
+    onVisibleChanged: {
+        if (visible) {
+            win.selected = 4;
+            keys.forceActiveFocus();
+        }
+    }
+
+    Timer {
+        id: countdownTimer
+        interval: 1000
+        repeat: true
+        onTriggered: {
+            win.countdown--;
+            if (win.countdown <= 0 && win.pending !== null) {
+                const a = win.pending;
+                win.fire(a);
+            }
+        }
+    }
+
+    MouseArea {
+        anchors.fill: parent
+        onClicked: win.cancel()
+    }
+
+    Item {
+        id: keys
+        anchors.fill: parent
+        focus: true
+
+        Keys.onPressed: event => {
+            if (event.key === Qt.Key_Escape) {
+                win.cancel();
+            } else if (event.key === Qt.Key_Left) {
+                win.selected = (win.selected + win.actions.length - 1) % win.actions.length;
+            } else if (event.key === Qt.Key_Right) {
+                win.selected = (win.selected + 1) % win.actions.length;
+            } else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
+                win.choose(win.actions[win.selected]);
+            } else {
+                const a = win.actions.find(x => x.key === event.text.toLowerCase());
+                if (a)
+                    win.choose(a);
+            }
+        }
+    }
+
+    Rectangle {
+        anchors.centerIn: parent
+        implicitWidth: menu.implicitWidth + 44
+        implicitHeight: menu.implicitHeight + 44
+        radius: Theme.radiusPanel
+        color: Theme.panel
+        border.width: 1
+        border.color: Theme.panelEdge
+
+        ColumnLayout {
+            id: menu
+            anchors.centerIn: parent
+            spacing: 16
+
+            Txt {
+                Layout.alignment: Qt.AlignHCenter
+                text: win.pending !== null ? win.pending.label + " in " + win.countdown + "…" : "Power"
+                size: 15
+                strong: true
+            }
+
+            RowLayout {
+                spacing: 12
+
+                Repeater {
+                    model: win.actions
+                    delegate: Rectangle {
+                        id: btn
+                        required property var modelData
+                        required property int index
+                        readonly property bool sel: win.selected === btn.index
+
+                        Layout.preferredWidth: 104
+                        Layout.preferredHeight: 104
+                        radius: 26
+                        color: btn.sel ? Theme.accent : Theme.tileOff
+                        border.width: btn.sel ? 2 : 1
+                        border.color: btn.sel ? Theme.warm : Theme.cardEdge
+
+                        ColumnLayout {
+                            anchors.centerIn: parent
+                            spacing: 10
+
+                            Glyph {
+                                Layout.alignment: Qt.AlignHCenter
+                                text: btn.modelData.glyph
+                                size: 28
+                                color: btn.sel ? Theme.onAccent : Theme.fg
+                            }
+                            Txt {
+                                Layout.alignment: Qt.AlignHCenter
+                                text: btn.modelData.label + " · " + btn.modelData.key.toUpperCase()
+                                size: 12
+                                strong: true
+                                color: btn.sel ? Theme.onAccent : Theme.fg
+                            }
+                        }
+
+                        MouseArea {
+                            anchors.fill: parent
+                            hoverEnabled: true
+                            cursorShape: Qt.PointingHandCursor
+                            onEntered: win.selected = btn.index
+                            onClicked: win.choose(btn.modelData)
+                        }
+                    }
+                }
+            }
+
+            Txt {
+                Layout.alignment: Qt.AlignHCenter
+                text: win.pending !== null ? "Esc to cancel" : "Restart and Shutdown ask first. Arrow keys or the letter shown."
+                size: 11
+                color: Theme.muted
+            }
+        }
+    }
+}
diff --git a/quickshell/.config/quickshell/components/Segment.qml b/quickshell/.config/quickshell/components/Segment.qml
new file mode 100644
index 0000000..6506b43
--- /dev/null
+++ b/quickshell/.config/quickshell/components/Segment.qml
@@ -0,0 +1,63 @@
+import QtQuick
+import "../services"
+
+// One clickable section inside a PillGroup. Hover and active states draw an
+// inset rounded plate so the outer pill outline stays unbroken.
+Item {
+    id: seg
+
+    property bool active: false
+    property bool divider: false          // thin line on the left edge
+    readonly property bool hovered: area.containsMouse
+    readonly property color ink: seg.active ? Theme.onAccent : Theme.fg
+
+    default property alias contents: row.data
+
+    signal clicked
+    signal rightClicked
+    signal scrolled(int dir)
+
+    implicitWidth: row.implicitWidth + 28
+    implicitHeight: 34
+
+    Rectangle {
+        anchors.fill: parent
+        anchors.margins: 3
+        radius: height / 2
+        color: seg.active ? Theme.accent : (seg.hovered ? Qt.alpha(Theme.fg, 0.12) : "transparent")
+
+        Behavior on color {
+            ColorAnimation { duration: 120 }
+        }
+    }
+
+    Rectangle {
+        visible: seg.divider && !seg.active
+        anchors.left: parent.left
+        anchors.verticalCenter: parent.verticalCenter
+        width: 1
+        height: 16
+        color: Qt.alpha(Theme.fg, 0.2)
+    }
+
+    MouseArea {
+        id: area
+        anchors.fill: parent
+        hoverEnabled: true
+        acceptedButtons: Qt.LeftButton | Qt.RightButton
+        cursorShape: Qt.PointingHandCursor
+        onClicked: mouse => {
+            if (mouse.button === Qt.RightButton)
+                seg.rightClicked();
+            else
+                seg.clicked();
+        }
+        onWheel: wheel => seg.scrolled(wheel.angleDelta.y > 0 ? 1 : -1)
+    }
+
+    Row {
+        id: row
+        anchors.centerIn: parent
+        spacing: 8
+    }
+}
diff --git a/quickshell/.config/quickshell/components/SliderRow.qml b/quickshell/.config/quickshell/components/SliderRow.qml
new file mode 100644
index 0000000..37251a5
--- /dev/null
+++ b/quickshell/.config/quickshell/components/SliderRow.qml
@@ -0,0 +1,107 @@
+import QtQuick
+import QtQuick.Layouts
+import "../services"
+
+// Full-width pill slider (brightness, volume). The fill is a blend of the
+// accent and the panel so the white label stays readable on both halves.
+Rectangle {
+    id: root
+
+    property string glyph: ""
+    property string label: ""
+    property string detail: ""
+    property real value: 0
+    property bool hasMore: false
+
+    signal moved(real v)
+    signal more
+
+    implicitHeight: 44
+    radius: 22
+    color: Theme.tileOff
+    border.width: 1
+    border.color: Theme.cardEdge
+    clip: true
+
+    Rectangle {
+        width: Math.max(root.height, root.width * Math.max(0, Math.min(1, root.value)))
+        height: parent.height
+        radius: 22
+        color: Theme.mix(Theme.bg, Theme.accent, 0.55)
+
+        Behavior on width {
+            enabled: !drag.pressed
+            NumberAnimation { duration: 90 }
+        }
+    }
+
+    RowLayout {
+        anchors.fill: parent
+        anchors.leftMargin: 14
+        anchors.rightMargin: 14
+        spacing: 10
+
+        Glyph {
+            text: root.glyph
+            color: Theme.fg
+        }
+        Txt {
+            Layout.fillWidth: true
+            text: root.label
+            strong: true
+        }
+        Txt {
+            visible: root.detail.length > 0
+            text: root.detail
+            size: 11
+            color: Theme.fg
+            Layout.maximumWidth: 120
+        }
+        Txt {
+            text: Math.round(root.value * 100) + "%"
+            strong: true
+        }
+        Item {
+            visible: root.hasMore
+            Layout.preferredWidth: 22
+            Layout.preferredHeight: 22
+        }
+    }
+
+    MouseArea {
+        id: drag
+        anchors.fill: parent
+        cursorShape: Qt.PointingHandCursor
+        preventStealing: true
+        onPressed: mouse => root.moved(Math.max(0, Math.min(1, mouse.x / width)))
+        onPositionChanged: mouse => {
+            if (pressed)
+                root.moved(Math.max(0, Math.min(1, mouse.x / width)));
+        }
+    }
+
+    // chevron sits above the drag area so it can open the detail page
+    Rectangle {
+        visible: root.hasMore
+        anchors.right: parent.right
+        anchors.rightMargin: 8
+        anchors.verticalCenter: parent.verticalCenter
+        width: 30
+        height: 30
+        radius: 15
+        color: chevron.containsMouse ? Qt.alpha(Theme.fg, 0.18) : "transparent"
+
+        Glyph {
+            anchors.centerIn: parent
+            text: "\uf054"
+            size: 12
+        }
+        MouseArea {
+            id: chevron
+            anchors.fill: parent
+            hoverEnabled: true
+            cursorShape: Qt.PointingHandCursor
+            onClicked: root.more()
+        }
+    }
+}
diff --git a/quickshell/.config/quickshell/components/ThemePage.qml b/quickshell/.config/quickshell/components/ThemePage.qml
new file mode 100644
index 0000000..9da13d2
--- /dev/null
+++ b/quickshell/.config/quickshell/components/ThemePage.qml
@@ -0,0 +1,140 @@
+import QtQuick
+import QtQuick.Layouts
+import Qt.labs.folderlistmodel
+import Quickshell
+import "../services"
+
+// Theme: pick a wallpaper and the whole desktop retheme itself. SetWallpaper.sh
+// sets the image and runs wallust, which rewrites qml_color.json (this shell),
+// the rofi, kitty and GTK palettes and the Hyprland borders.
+ColumnLayout {
+    id: page
+
+    readonly property string wallDir: Sys.home + "/Pictures/wallpapers"
+
+    function apply(path) {
+        Quickshell.execDetached([Sys.scriptsDir + "/SetWallpaper.sh", path]);
+    }
+
+    spacing: 10
+
+    PageHeader {
+        Layout.fillWidth: true
+        title: "Theme"
+    }
+
+    // live palette preview: the colours wallust just produced
+    RowLayout {
+        Layout.fillWidth: true
+        spacing: 6
+
+        Repeater {
+            model: 8
+            delegate: Rectangle {
+                required property int index
+                Layout.fillWidth: true
+                implicitHeight: 22
+                radius: 11
+                color: Theme.pick("color" + (index + 1), "#000000")
+                border.width: 1
+                border.color: Theme.cardEdge
+            }
+        }
+    }
+
+    Txt {
+        Layout.fillWidth: true
+        text: "Colours follow the wallpaper. Pick one and the bar, panels, rofi, terminal and borders recolour."
+        size: 11
+        color: Theme.muted
+        wrapMode: Text.Wrap
+        maximumLineCount: 2
+    }
+
+    Txt {
+        Layout.fillWidth: true
+        visible: wallpapers.count === 0
+        text: "No images in ~/Pictures/wallpapers"
+        color: Theme.muted
+    }
+
+    GridView {
+        id: grid
+        Layout.fillWidth: true
+        visible: wallpapers.count > 0
+        implicitHeight: 3 * cellHeight
+        cellWidth: Math.floor(width / 3)
+        cellHeight: Math.round(cellWidth * 0.62)
+        clip: true
+        boundsBehavior: Flickable.StopAtBounds
+
+        model: FolderListModel {
+            id: wallpapers
+            folder: "file://" + page.wallDir
+            nameFilters: ["*.jpg", "*.jpeg", "*.png", "*.webp", "*.JPG", "*.JPEG", "*.PNG", "*.WEBP"]
+            showDirs: false
+            sortField: FolderListModel.Name
+        }
+
+        delegate: Item {
+            id: cell
+            required property string filePath
+            required property url fileUrl
+            required property string fileName
+
+            width: grid.cellWidth
+            height: grid.cellHeight
+
+            Rectangle {
+                anchors.fill: parent
+                anchors.margins: 3
+                radius: 12
+                clip: true
+                color: Theme.card
+                border.width: thumb.containsMouse ? 2 : 1
+                border.color: thumb.containsMouse ? Theme.accentEdge : Theme.cardEdge
+
+                Image {
+                    anchors.fill: parent
+                    anchors.margins: 1
+                    source: cell.fileUrl
+                    sourceSize: Qt.size(260, 170)
+                    asynchronous: true
+                    fillMode: Image.PreserveAspectCrop
+                }
+
+                MouseArea {
+                    id: thumb
+                    anchors.fill: parent
+                    hoverEnabled: true
+                    cursorShape: Qt.PointingHandCursor
+                    onClicked: page.apply(cell.filePath)
+                }
+            }
+        }
+    }
+
+    RowLayout {
+        Layout.fillWidth: true
+        spacing: 6
+
+        Chip {
+            text: "Random"
+            onClicked: Quickshell.execDetached([Sys.home + "/.config/hypr/UserScripts/WallpaperRandom.sh"])
+        }
+        Chip {
+            text: "Dark / Light"
+            onClicked: Quickshell.execDetached([Sys.scriptsDir + "/DarkLight.sh"])
+        }
+        Chip {
+            text: "Rofi picker"
+            onClicked: {
+                UiState.ccOpen = false;
+                Quickshell.execDetached([Sys.home + "/.config/hypr/UserScripts/WallpaperSelect.sh"]);
+            }
+        }
+        Item {
+            Layout.fillWidth: true
+        }
+    }
+}
diff --git a/quickshell/.config/quickshell/components/Tile.qml b/quickshell/.config/quickshell/components/Tile.qml
new file mode 100644
index 0000000..27c3722
--- /dev/null
+++ b/quickshell/.config/quickshell/components/Tile.qml
@@ -0,0 +1,102 @@
+import QtQuick
+import QtQuick.Layouts
+import "../services"
+
+// Control Center toggle. Left click toggles. If `hasMore` is set there is a
+// chevron (and right-click) that opens the detail page instead.
+Rectangle {
+    id: tile
+
+    property bool on: false
+    property bool hasMore: false
+    property string glyph: ""
+    property string title: ""
+    property string sub: ""
+
+    readonly property color ink: tile.on ? Theme.onAccent : Theme.fg
+    readonly property color inkSub: tile.on ? Qt.alpha(Theme.onAccent, 0.85) : Theme.muted
+
+    signal clicked
+    signal more
+
+    implicitHeight: 64
+    radius: Theme.radiusCard
+    color: tile.on ? Theme.accent : (area.containsMouse ? Qt.alpha(Theme.fg, 0.11) : Theme.tileOff)
+    border.width: 1
+    border.color: tile.on ? Theme.accentEdge : Theme.cardEdge
+
+    // below the content so the chevron's own click area wins
+    MouseArea {
+        id: area
+        anchors.fill: parent
+        hoverEnabled: true
+        acceptedButtons: Qt.LeftButton | Qt.RightButton
+        cursorShape: Qt.PointingHandCursor
+        onClicked: mouse => {
+            if (mouse.button === Qt.RightButton && tile.hasMore)
+                tile.more();
+            else
+                tile.clicked();
+        }
+    }
+
+    RowLayout {
+        anchors.fill: parent
+        anchors.leftMargin: 14
+        anchors.rightMargin: 8
+        spacing: 12
+
+        Rectangle {
+            Layout.preferredWidth: 36
+            Layout.preferredHeight: 36
+            radius: 18
+            color: tile.on ? Qt.alpha(Theme.onAccent, 0.18) : Qt.alpha(Theme.fg, 0.1)
+
+            Glyph {
+                anchors.centerIn: parent
+                text: tile.glyph
+                color: tile.ink
+            }
+        }
+
+        ColumnLayout {
+            Layout.fillWidth: true
+            spacing: 1
+
+            Txt {
+                Layout.fillWidth: true
+                text: tile.title
+                strong: true
+                color: tile.ink
+            }
+            Txt {
+                Layout.fillWidth: true
+                text: tile.sub
+                size: 11
+                color: tile.inkSub
+            }
+        }
+
+        Rectangle {
+            visible: tile.hasMore
+            Layout.preferredWidth: 30
+            Layout.preferredHeight: 30
+            radius: 15
+            color: chevron.containsMouse ? Qt.alpha(tile.ink, 0.18) : "transparent"
+
+            Glyph {
+                anchors.centerIn: parent
+                text: ""
+                size: 12
+                color: tile.ink
+            }
+            MouseArea {
+                id: chevron
+                anchors.fill: parent
+                hoverEnabled: true
+                cursorShape: Qt.PointingHandCursor
+                onClicked: tile.more()
+            }
+        }
+    }
+}
diff --git a/quickshell/.config/quickshell/components/Toasts.qml b/quickshell/.config/quickshell/components/Toasts.qml
new file mode 100644
index 0000000..9775c8a
--- /dev/null
+++ b/quickshell/.config/quickshell/components/Toasts.qml
@@ -0,0 +1,51 @@
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Wayland
+import Quickshell.Hyprland
+import "../services"
+
+// Toast stack, top-right under the bar. Hidden while the Control Center is
+// open (the shade already shows everything).
+PanelWindow {
+    id: win
+
+    readonly property var focusedScreen: Quickshell.screens.find(s => s.name === Hyprland.focusedMonitor?.name) ?? Quickshell.screens[0]
+
+    screen: win.focusedScreen
+    visible: Notifs.popups.length > 0 && !UiState.ccOpen
+    color: "transparent"
+    anchors {
+        top: true
+        right: true
+    }
+    margins {
+        top: 56
+        right: 12
+    }
+    exclusionMode: ExclusionMode.Ignore
+    implicitWidth: 420
+    implicitHeight: Math.max(1, stack.implicitHeight)
+
+    WlrLayershell.namespace: "qs-toasts"
+    WlrLayershell.layer: WlrLayer.Overlay
+    WlrLayershell.keyboardFocus: WlrKeyboardFocus.OnDemand
+
+    ColumnLayout {
+        id: stack
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.top: parent.top
+        spacing: 10
+
+        Repeater {
+            model: Notifs.popups
+            delegate: NotifCard {
+                required property var modelData
+                Layout.fillWidth: true
+                toast: true
+                notif: modelData
+            }
+        }
+    }
+}
