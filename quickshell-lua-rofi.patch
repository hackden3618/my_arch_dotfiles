diff --git a/quickshell/.config/quickshell/components/IconButton.qml b/quickshell/.config/quickshell/components/IconButton.qml
new file mode 100644
index 0000000..0fe8d71
--- /dev/null
+++ b/quickshell/.config/quickshell/components/IconButton.qml
@@ -0,0 +1,34 @@
+import QtQuick
+import "../services"
+
+Rectangle {
+    id: btn
+
+    property string glyph: ""
+    property bool primary: false
+    property int size: 36
+
+    signal clicked
+
+    implicitWidth: btn.size
+    implicitHeight: btn.size
+    radius: btn.size / 2
+    color: btn.primary ? Theme.warm : (area.containsMouse ? Qt.alpha(Theme.fg, 0.16) : Qt.alpha(Theme.fg, 0.08))
+    border.width: btn.primary ? 0 : 1
+    border.color: Qt.alpha(Theme.fg, 0.1)
+
+    Glyph {
+        anchors.centerIn: parent
+        text: btn.glyph
+        size: Math.round(btn.size * 0.44)
+        color: btn.primary ? Theme.ink : Theme.fg
+    }
+
+    MouseArea {
+        id: area
+        anchors.fill: parent
+        hoverEnabled: true
+        cursorShape: Qt.PointingHandCursor
+        onClicked: btn.clicked()
+    }
+}
diff --git a/quickshell/.config/quickshell/components/ListRow.qml b/quickshell/.config/quickshell/components/ListRow.qml
