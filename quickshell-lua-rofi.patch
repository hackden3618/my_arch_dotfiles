diff --git a/quickshell/.config/quickshell/components/AudioPage.qml b/quickshell/.config/quickshell/components/AudioPage.qml
new file mode 100644
index 0000000..c1c7a39
--- /dev/null
+++ b/quickshell/.config/quickshell/components/AudioPage.qml
@@ -0,0 +1,74 @@
+import QtQuick
+import QtQuick.Layouts
+import Quickshell.Services.Pipewire
+import "../services"
+
+// Sound: pick the output device and set volume per app.
+ColumnLayout {
+    id: page
+
+    readonly property var nodes: Pipewire.nodes.values
+    readonly property var sinks: page.nodes.filter(n => n.isSink && !n.isStream)
+    readonly property var streams: page.nodes.filter(n => n.isSink && n.isStream)
+
+    spacing: 10
+
+    PwObjectTracker {
+        objects: page.sinks.concat(page.streams)
+    }
+
+    PageHeader {
+        Layout.fillWidth: true
+        title: "Sound"
+    }
+
+    SliderRow {
+        Layout.fillWidth: true
+        glyph: Audio.muted ? "" : ""
+        label: "Output volume"
+        value: Audio.muted ? 0 : Audio.volume
+        onMoved: v => Audio.setVolume(v)
+    }
+
+    Txt {
+        text: "Output device"
+        size: 11
+        color: Theme.muted
+    }
+
+    Repeater {
+        model: page.sinks
+        delegate: ListRow {
+            id: sink
+            required property var modelData
+            Layout.fillWidth: true
+            glyph: ""
+            title: sink.modelData.nickname || sink.modelData.description || sink.modelData.name
+            active: Audio.sink !== null && Audio.sink !== undefined && Audio.sink.id === sink.modelData.id
+            onClicked: Pipewire.preferredDefaultAudioSink = sink.modelData
+        }
+    }
+
+    Txt {
+        visible: page.streams.length > 0
+        text: "Apps"
+        size: 11
+        color: Theme.muted
+    }
+
+    Repeater {
+        model: page.streams
+        delegate: SliderRow {
+            id: stream
+            required property var modelData
+            Layout.fillWidth: true
+            glyph: ""
+            label: (stream.modelData.properties && stream.modelData.properties["application.name"]) || stream.modelData.description || stream.modelData.name
+            value: stream.modelData.audio ? stream.modelData.audio.volume : 0
+            onMoved: v => {
+                if (stream.modelData.audio)
+                    stream.modelData.audio.volume = v;
+            }
+        }
+    }
+}
diff --git a/quickshell/.config/quickshell/components/Bar.qml b/quickshell/.config/quickshell/components/Bar.qml
new file mode 100644
index 0000000..ebfb525
--- /dev/null
+++ b/quickshell/.config/quickshell/components/Bar.qml
@@ -0,0 +1,410 @@
+import QtQuick
+import Quickshell
+import Quickshell.Wayland
+import Quickshell.Hyprland
+import Quickshell.Services.SystemTray
+import Quickshell.Services.Mpris
+import Quickshell.Services.UPower
+import Quickshell.Bluetooth
+import "../services"
+
+// The waybar layout, rebuilt: clock + media + tray + window on the left,
+// workspaces + notifications in the centre, status pills on the right.
+PanelWindow {
+    id: bar
+
+    required property var modelData
+
+    readonly property bool wide: bar.width >= 1700
+    readonly property var battery: UPower.displayDevice
+    readonly property var player: {
+        const list = Mpris.players.values;
+        return list.find(p => p.isPlaying) ?? list[0] ?? null;
+    }
+
+    function volGlyph() {
+        if (Audio.muted || Audio.volume <= 0) return "";
+        return Audio.volume < 0.34 ? "" : "";
+    }
+    function fmtSecs(sec) {
+        if (!(sec > 0))
+            return "";
+        const h = Math.floor(sec / 3600);
+        const m = Math.floor((sec % 3600) / 60);
+        return h > 0 ? h + "h " + String(m).padStart(2, "0") + "m" : m + "m";
+    }
+    function focusWorkspace(id) {
+        // Hyprland's Lua mode evaluates dispatches as Lua, so use the native form
+        Quickshell.execDetached(["hyprctl", "dispatch", 'hl.dsp.focus({ workspace = "' + id + '" })']);
+    }
+    function batGlyph(p) {
+        if (p > 0.875) return "";
+        if (p > 0.625) return "";
+        if (p > 0.375) return "";
+        if (p > 0.125) return "";
+        return "";
+    }
+
+    screen: modelData
+    anchors {
+        top: true
+        left: true
+        right: true
+    }
+    implicitHeight: 48
+    color: "transparent"
+
+    WlrLayershell.namespace: "qs-bar"
+
+    IdleInhibitor {
+        window: bar
+        enabled: UiState.caffeine
+    }
+
+    SystemClock {
+        id: clock
+        precision: SystemClock.Minutes
+    }
+
+    Item {
+        anchors.fill: parent
+        anchors.leftMargin: 8
+        anchors.rightMargin: 8
+        anchors.topMargin: 5
+
+        // ================= left =================
+        Row {
+            id: left
+            anchors.left: parent.left
+            spacing: 6
+
+            Pill {
+                onClicked: UiState.toggleCc()
+                Txt {
+                    text: Qt.formatDateTime(clock.date, "ddd dd")
+                    strong: true
+                }
+                Txt {
+                    text: "|"
+                    color: Theme.muted
+                }
+                Txt {
+                    text: Qt.formatDateTime(clock.date, "HH:mm")
+                    strong: true
+                }
+            }
+
+            Pill {
+                visible: bar.player !== null
+                onClicked: {
+                    if (bar.player && bar.player.canTogglePlaying)
+                        bar.player.togglePlaying();
+                }
+                Glyph {
+                    text: ""
+                    size: 14
+                    color: bar.player && bar.player.isPlaying ? Theme.warm : Theme.fg
+                }
+                Txt {
+                    width: Math.min(implicitWidth, 160)
+                    text: bar.player ? (bar.player.trackTitle || bar.player.identity) : ""
+                    strong: true
+                }
+            }
+
+            Pill {
+                visible: SystemTray.items.values.length > 0
+                Repeater {
+                    model: SystemTray.items
+                    delegate: Item {
+                        id: trayItem
+                        required property var modelData
+                        width: 20
+                        height: 20
+
+                        Image {
+                            anchors.fill: parent
+                            source: trayItem.modelData.icon
+                            sourceSize: Qt.size(40, 40)
+                            fillMode: Image.PreserveAspectFit
+                        }
+                        MouseArea {
+                            anchors.fill: parent
+                            acceptedButtons: Qt.LeftButton | Qt.RightButton | Qt.MiddleButton
+                            cursorShape: Qt.PointingHandCursor
+                            onClicked: mouse => {
+                                if (mouse.button === Qt.LeftButton) {
+                                    trayItem.modelData.activate();
+                                } else if (mouse.button === Qt.MiddleButton) {
+                                    trayItem.modelData.secondaryActivate();
+                                } else if (trayItem.modelData.hasMenu) {
+                                    const p = trayItem.mapToItem(null, mouse.x, mouse.y);
+                                    trayItem.modelData.display(bar, p.x, p.y);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+
+            Pill {
+                visible: bar.wide && title.text.length > 0
+                Rectangle {
+                    width: 8
+                    height: 8
+                    radius: 4
+                    color: Theme.warm
+                    anchors.verticalCenter: parent.verticalCenter
+                }
+                Txt {
+                    id: title
+                    width: Math.min(implicitWidth, 240)
+                    text: Hyprland.activeToplevel ? Hyprland.activeToplevel.title : ""
+                    strong: true
+                }
+            }
+        }
+
+        // ================= centre =================
+        Row {
+            id: centre
+            anchors.horizontalCenter: parent.horizontalCenter
+            spacing: 6
+
+            Pill {
+                // workspace strip: tighter padding, the buttons carry their own
+                implicitWidth: ws.implicitWidth + 14
+                Row {
+                    id: ws
+                    spacing: 2
+                    Repeater {
+                        model: 5
+                        delegate: Rectangle {
+                            id: wsBtn
+                            required property int index
+                            readonly property int wsId: wsBtn.index + 1
+                            readonly property bool current: Hyprland.focusedWorkspace !== null && Hyprland.focusedWorkspace.id === wsBtn.wsId
+                            readonly property bool occupied: Hyprland.workspaces.values.some(w => w.id === wsBtn.wsId)
+
+                            width: wsBtn.current ? 46 : 32
+                            height: 26
+                            radius: 9
+                            color: wsBtn.current ? Theme.bg : (wsArea.containsMouse ? Qt.alpha(Theme.fg, 0.12) : "transparent")
+
+                            Behavior on width {
+                                NumberAnimation { duration: 140; easing.type: Easing.OutCubic }
+                            }
+
+                            Row {
+                                anchors.centerIn: parent
+                                spacing: 5
+                                Txt {
+                                    text: wsBtn.wsId
+                                    strong: true
+                                    color: wsBtn.current ? Theme.warm : Theme.fg
+                                }
+                                Rectangle {
+                                    visible: wsBtn.occupied
+                                    width: 6
+                                    height: 6
+                                    radius: 3
+                                    anchors.verticalCenter: parent.verticalCenter
+                                    color: wsBtn.current ? Theme.warm : Theme.muted
+                                }
+                            }
+
+                            MouseArea {
+                                id: wsArea
+                                anchors.fill: parent
+                                hoverEnabled: true
+                                cursorShape: Qt.PointingHandCursor
+                                onClicked: bar.focusWorkspace(wsBtn.wsId)
+                            }
+                        }
+                    }
+                }
+            }
+
+            Pill {
+                urgent: false
+                onClicked: UiState.toggleCc()
+                Glyph {
+                    text: Notifs.dnd ? "" : ""
+                    size: 15
+                }
+                Txt {
+                    text: Notifs.count
+                    strong: true
+                }
+                Rectangle {
+                    visible: Notifs.count > 0 && !Notifs.dnd
+                    width: 8
+                    height: 8
+                    radius: 4
+                    color: Theme.danger
+                    anchors.verticalCenter: parent.verticalCenter
+                }
+            }
+        }
+
+        // ================= right =================
+        Row {
+            id: right
+            anchors.right: parent.right
+            spacing: 6
+
+            Pill {
+                onClicked: UiState.toggleCc()
+                onScrolled: dir => (dir > 0 ? Audio.inc() : Audio.dec())
+                Glyph {
+                    text: bar.volGlyph()
+                    size: 15
+                }
+                Txt {
+                    text: Audio.muted ? "mute" : Math.round(Audio.volume * 100) + "%"
+                    strong: true
+                }
+            }
+
+            Pill {
+                onClicked: UiState.toggleCc()
+                onScrolled: dir => Sys.stepBrightness(dir)
+                Glyph {
+                    text: ""
+                    size: 15
+                }
+                Txt {
+                    text: Math.round(Sys.bright * 100) + "%"
+                    strong: true
+                }
+            }
+
+            // battery | network speed | bluetooth (only when connected) | control center
+            PillGroup {
+                urgent: batSeg.critical
+
+                Segment {
+                    id: batSeg
+
+                    readonly property var dev: bar.battery
+                    readonly property int st: dev ? dev.state : UPowerDeviceState.Unknown
+                    readonly property bool charging: st === UPowerDeviceState.Charging
+                    readonly property bool full: st === UPowerDeviceState.FullyCharged
+                    readonly property bool plugged: st === UPowerDeviceState.PendingCharge
+                    readonly property bool onAc: charging || full || plugged
+                    readonly property real pct: dev ? dev.percentage : 1
+                    readonly property bool critical: !onAc && pct < 0.15
+                    readonly property bool low: !onAc && pct < 0.30
+                    readonly property color tone: critical ? Theme.danger : (onAc ? Theme.ok : (low ? Theme.warm : Theme.fg))
+                    // "1h 05m to full", "3h 20m left", "Full", "Plugged in"
+                    readonly property string detail: {
+                        if (!dev) return "";
+                        if (charging) { const t = bar.fmtSecs(dev.timeToFull); return t ? t + " to full" : "Charging"; }
+                        if (full) return "Full";
+                        if (plugged) return "Plugged in";
+                        const t = bar.fmtSecs(dev.timeToEmpty);
+                        return t ? t + " left" : "";
+                    }
+
+                    visible: dev !== null && dev.isPresent
+                    onClicked: UiState.toggleCc()
+
+                    Glyph {
+                        visible: batSeg.charging
+                        text: "\uf0e7"
+                        size: 13
+                        color: Theme.ok
+                    }
+                    Glyph {
+                        visible: batSeg.plugged
+                        text: "\uf1e6"
+                        size: 13
+                        color: Theme.ok
+                    }
+                    Glyph {
+                        text: bar.batGlyph(batSeg.full ? 1 : batSeg.pct)
+                        size: 15
+                        color: batSeg.tone
+                    }
+                    Txt {
+                        text: Math.round(batSeg.pct * 100) + "%"
+                        strong: true
+                        color: batSeg.tone
+                    }
+                    Txt {
+                        visible: bar.wide && batSeg.detail.length > 0
+                        text: batSeg.detail
+                        size: 11
+                        color: batSeg.onAc ? Theme.ok : Theme.muted
+                    }
+                }
+
+                // network throughput replaces the Wi-Fi icon; right-click for Wi-Fi settings
+                Segment {
+                    divider: batSeg.visible
+                    onClicked: UiState.toggleCc()
+                    onRightClicked: UiState.openPage("wifi")
+
+                    Glyph {
+                        text: "\uf062"
+                        size: 11
+                        color: Sys.wifiOn ? Theme.fg : Theme.muted
+                    }
+                    Txt {
+                        width: Math.max(implicitWidth, 58)
+                        horizontalAlignment: Text.AlignRight
+                        text: Sys.fmtRate(Sys.txRate)
+                        strong: true
+                    }
+                    Glyph {
+                        text: "\uf063"
+                        size: 11
+                        color: Sys.wifiOn ? Theme.fg : Theme.muted
+                    }
+                    Txt {
+                        width: Math.max(implicitWidth, 58)
+                        horizontalAlignment: Text.AlignRight
+                        text: Sys.fmtRate(Sys.rxRate)
+                        strong: true
+                    }
+                }
+
+                // only present while a Bluetooth device is connected
+                Segment {
+                    id: btSeg
+
+                    readonly property var adapter: Bluetooth.defaultAdapter
+                    readonly property int connected: adapter ? adapter.devices.values.filter(d => d.connected).length : 0
+
+                    visible: connected > 0
+                    divider: true
+                    onClicked: UiState.toggleCc()
+                    onRightClicked: UiState.openPage("bluetooth")
+
+                    Glyph {
+                        text: "\uf293"
+                        size: 15
+                    }
+                    Txt {
+                        visible: btSeg.connected > 1
+                        text: btSeg.connected
+                        strong: true
+                    }
+                }
+
+                Segment {
+                    id: ctlSeg
+                    active: UiState.ccOpen
+                    divider: true
+                    onClicked: UiState.toggleCc()
+
+                    Glyph {
+                        text: "\uf1de"
+                        size: 15
+                        color: ctlSeg.ink
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/quickshell/.config/quickshell/components/BluetoothPage.qml b/quickshell/.config/quickshell/components/BluetoothPage.qml
new file mode 100644
index 0000000..e0b2eec
--- /dev/null
+++ b/quickshell/.config/quickshell/components/BluetoothPage.qml
@@ -0,0 +1,143 @@
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Bluetooth
+import "../services"
+
+// Bluetooth: switch, paired + nearby devices, connect / disconnect / pair /
+// forget. Scanning runs only while this page is open.
+ColumnLayout {
+    id: page
+
+    readonly property var adapter: Bluetooth.defaultAdapter
+    readonly property bool btOn: page.adapter ? page.adapter.enabled : false
+
+    readonly property var devices: {
+        if (!page.adapter)
+            return [];
+        const scanning = page.adapter.discovering;
+        const list = page.adapter.devices.values.filter(d => d.connected || d.paired || (scanning && d.name && d.name.length > 0));
+        list.sort((a, b) => (b.connected - a.connected) || (b.paired - a.paired) || a.name.localeCompare(b.name));
+        return list;
+    }
+
+    function glyphFor(icon) {
+        const i = icon || "";
+        if (i.indexOf("headset") >= 0 || i.indexOf("headphone") >= 0) return "";
+        if (i.indexOf("mouse") >= 0) return "";
+        if (i.indexOf("keyboard") >= 0) return "";
+        if (i.indexOf("phone") >= 0) return "";
+        return "";
+    }
+
+    spacing: 10
+
+    onVisibleChanged: {
+        if (page.adapter && page.adapter.enabled)
+            page.adapter.discovering = page.visible;
+        else if (page.adapter && !page.visible)
+            page.adapter.discovering = false;
+    }
+
+    PageHeader {
+        Layout.fillWidth: true
+        title: "Bluetooth"
+        switchable: true
+        checked: page.btOn
+        onToggled: {
+            if (page.adapter)
+                page.adapter.enabled = !page.adapter.enabled;
+        }
+    }
+
+    Txt {
+        Layout.fillWidth: true
+        visible: !page.adapter
+        text: "No Bluetooth adapter found"
+        color: Theme.muted
+    }
+    Txt {
+        Layout.fillWidth: true
+        visible: page.adapter && !page.btOn
+        text: "Bluetooth is off"
+        color: Theme.muted
+    }
+    Txt {
+        Layout.fillWidth: true
+        visible: page.btOn && page.devices.length === 0
+        text: page.adapter && page.adapter.discovering ? "Searching for devices…" : "No devices. Tap Scan."
+        color: Theme.muted
+    }
+
+    Flickable {
+        Layout.fillWidth: true
+        visible: page.btOn && page.devices.length > 0
+        implicitHeight: Math.min(list.implicitHeight, 340)
+        contentHeight: list.implicitHeight
+        clip: true
+        boundsBehavior: Flickable.StopAtBounds
+
+        ColumnLayout {
+            id: list
+            width: parent.width
+            spacing: 6
+
+            Repeater {
+                model: page.devices
+                delegate: ListRow {
+                    id: dev
+                    required property var modelData
+                    readonly property bool working: dev.modelData.state === BluetoothDeviceState.Connecting || dev.modelData.state === BluetoothDeviceState.Disconnecting
+
+                    Layout.fillWidth: true
+                    glyph: page.glyphFor(dev.modelData.icon)
+                    title: dev.modelData.name
+                    subtitle: dev.modelData.connected ? "Connected" + (dev.modelData.batteryAvailable ? " · " + Math.round(dev.modelData.battery * 100) + "%" : "") : (dev.modelData.paired ? "Paired" : "Available")
+                    active: dev.modelData.connected
+                    busy: dev.working
+
+                    onClicked: {
+                        if (dev.working)
+                            return;
+                        if (dev.modelData.connected)
+                            dev.modelData.disconnect();
+                        else if (dev.modelData.paired)
+                            dev.modelData.connect();
+                        else
+                            dev.modelData.pair();
+                    }
+
+                    Chip {
+                        visible: dev.modelData.paired
+                        text: "Forget"
+                        onClicked: dev.modelData.forget()
+                    }
+                }
+            }
+        }
+    }
+
+    RowLayout {
+        Layout.fillWidth: true
+        spacing: 6
+
+        Chip {
+            visible: page.btOn
+            text: page.adapter && page.adapter.discovering ? "Stop scan" : "Scan"
+            onClicked: {
+                if (page.adapter)
+                    page.adapter.discovering = !page.adapter.discovering;
+            }
+        }
+        Chip {
+            text: "More settings"
+            onClicked: {
+                UiState.ccOpen = false;
+                Quickshell.execDetached(["blueman-manager"]);
+            }
+        }
+        Item {
+            Layout.fillWidth: true
+        }
+    }
+}
diff --git a/quickshell/.config/quickshell/components/Chip.qml b/quickshell/.config/quickshell/components/Chip.qml
